{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "vitest", "import"],
  "categories": { "correctness": "error", "suspicious": "warn" },
  "rules": {
    "vitest/expect-expect": ["error", { "assertFunctionNames": ["expect", "check"] }]
  },
  "ignorePatterns": ["dist/**"]
}
