{
  "name": "typolint",
  "version": "0.1.0",
  "description": "Locale-aware typography linter for UI copy: quotes, apostrophes, ellipses, dashes, spaces.",
  "keywords": [
    "apostrophe",
    "cldr",
    "i18n",
    "icu",
    "l10n",
    "lint",
    "linter",
    "messageformat",
    "quotes",
    "typography",
    "yaml"
  ],
  "homepage": "https://github.com/el-schneider/typolint#readme",
  "bugs": "https://github.com/el-schneider/typolint/issues",
  "license": "MIT",
  "author": "Jonas Schneider",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/el-schneider/typolint.git"
  },
  "bin": {
    "typolint": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "locales": "node scripts/build-locales.ts",
    "prepublishOnly": "pnpm check"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.21",
    "@types/node": "26.6.5",
    "cldr-misc-full": "48.2.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "yaml": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "yaml": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.10.1"
}
